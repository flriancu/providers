{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "unicorn/no-array-sort": "off",
    "vitest/require-to-throw-message": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "fails"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "src/domain is plain TypeScript (NFR-04)."
              },
              {
                "name": "react-dom",
                "message": "src/domain is plain TypeScript (NFR-04)."
              },
              {
                "name": "drive-doc-sync",
                "message": "src/domain is plain TypeScript (NFR-04); only drive-doc-sync/errors is allowed.",
                "allowTypeImports": true
              }
            ],
            "patterns": [
              {
                "group": ["../ui/*", "../spike/*", "react-dom/*"],
                "message": "src/domain is plain TypeScript (NFR-04)."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "window",
            "message": "src/domain has no browser (NFR-04)."
          },
          {
            "name": "document",
            "message": "src/domain has no browser (NFR-04)."
          },
          {
            "name": "localStorage",
            "message": "src/domain has no browser (NFR-04)."
          },
          {
            "name": "sessionStorage",
            "message": "src/domain has no browser (NFR-04)."
          },
          {
            "name": "fetch",
            "message": "src/domain makes no requests (NFR-04)."
          },
          {
            "name": "navigator",
            "message": "src/domain has no browser (NFR-04)."
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "playwright-report", "test-results"]
}
